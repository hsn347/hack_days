[Unit]
Description=Empire Bot FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/osmanli
ExecStart=/var/www/osmanli/venv/bin/python api_server.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=CORS_ORIGINS=*

[Install]
WantedBy=multi-user.target
