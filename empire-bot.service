[Unit]
Description=Empire Bot FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/osmanli
ExecStart=/var/www/osmanli/venv/bin/python api_server.py --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
StandardOutput=append:/var/www/osmanli/api_server.log
StandardError=append:/var/www/osmanli/bot_errors.log
Environment=PYTHONUNBUFFERED=1
Environment=CORS_ORIGINS=*
Environment=GRPC_DNS_RESOLVER=native

[Install]
WantedBy=multi-user.target
